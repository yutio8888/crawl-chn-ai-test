# M panel smoke test — Deep Elf Conjurer starts with Magic Dart memorised,
# so the M (spells) panel is safe to open. Verifies the panel doesn't crash.
# (M panel crashes on any character without memorised spells — assertion failure.)
name = zh_m_panel
species = de
background = cj
weapon = short sword
restart_after_game = false
show_more = false

Lua{
local eol = string.char(13)
local esc = string.char(27)
local done = false

function ready()
    if done then return end
    done = true
    crawl.sendkeys("&yes" .. eol .. esc)
    local tr = crawl.t_("You attack %s.")
    crawl.stderr("FRAME_MARKER: probe | t_=" .. tr .. eol)

    -- M panel: DE Cj has spells memorised by default
    crawl.sendkeys("M" .. esc)
    crawl.stderr("FRAME_MARKER: panel:spells | opened" .. eol)

    crawl.sendkeys(string.char(19)) -- quit
end
}
