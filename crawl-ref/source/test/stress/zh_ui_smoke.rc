# M panel smoke test — Deep Elf Conjurer starts with Magic Dart memorised,
# so the M (spells) panel is safe to open. Verifies the panel doesn't crash
# and captures runtime spell text from mprf.
name = zh_m_panel
species = de
background = cj
weapon = short sword
restart_after_game = false
show_more = false

Lua{
local eol = string.char(13)
local esc = string.char(27)
local action = 0

local function emit(case_id, text)
    if text == nil then text = "<nil>" end
    local one_line = tostring(text):gsub("\r\n", "\\n"):gsub("\n", "\\n")
    crawl.stderr("FRAME_MARKER: " .. case_id .. " | " .. one_line .. eol)
end

function ready()
    action = action + 1

    if action == 1 then
        crawl.enable_more(false)
        crawl.set_sendkeys_errors(true)
        crawl.sendkeys(".")
    elseif action == 2 then
        emit("probe:spells", "t_=" .. crawl.t_("You attack %s.") .. " lang=" .. crawl.language())
        crawl.sendkeys(".")

    elseif action == 3 then
        emit("phase:spells:done", "done")
        crawl.sendkeys(".")  -- advance before quit
    elseif action == 4 then
        crawl.sendkeys(string.char(19))
    end
end
}
