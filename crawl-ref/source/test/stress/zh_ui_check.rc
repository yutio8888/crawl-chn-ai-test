name = zh_ui_check
species = mu
background = ck
weapon = mace
restart_after_game = false
show_more = false

Lua{
local eol  = string.char(13)
local esc  = string.char(27)
local action = 0

local function emit(case_id, text)
    if text == nil then text = "<nil>" end
    local one_line = tostring(text):gsub("\r\n", "\\n"):gsub("\n", "\\n")
    crawl.stderr("FRAME_MARKER: " .. case_id .. " | " .. one_line .. eol)
end

function ready()
    action = action + 1

    if action == 1 then
        crawl.enable_more(false)
        crawl.set_sendkeys_errors(true)
        crawl.sendkeys(".")
    elseif action == 2 then
        emit("probe:ui", "t_=" .. crawl.t_("You attack %s.") .. " lang=" .. crawl.language())
        crawl.sendkeys(".")
    elseif action == 3 then
        crawl.clear_messages(false)
        crawl.sendkeys("&o)demon whip" .. eol .. "chaos" .. eol)
    elseif action == 4 then
        crawl.sendkeys(".")
    elseif action == 5 then
        -- Capture messages from item creation (dedicated ready() for safety)
        local msgs = crawl.messages(20) or ""
        emit("item:chaos_demon_whip", msgs)
        crawl.sendkeys(".")
    elseif action == 6 then
        crawl.clear_messages(false)
        crawl.sendkeys("g&o[boots" .. eol .. "running" .. eol)
    elseif action == 7 then
        crawl.sendkeys(".")
    elseif action == 8 then
        local boots_name = nil
        local protocol = nil
        for _, it in pairs(items.inventory()) do
            if it.subtype_en(false) == "mace" then
                local skill = it.weap_skill_en
                local ego = it.ego_en(true)
                local annot = ch_stash_search_annotate_item(it)
                assert(skill == "Maces & Flails",
                       "unexpected canonical weapon skill: " .. tostring(skill))
                assert(ego and not ego:find("[^%w ]"),
                       "unexpected canonical weapon ego: " .. tostring(ego))
                assert(annot:find("{Maces & Flails}", 1, true),
                       "stash annotation omitted canonical weapon skill")
                assert(annot:find("{" .. ego .. "}", 1, true),
                       "stash annotation omitted canonical weapon ego")
                assert(ego == "chaos",
                       "unexpected canonical starter weapon ego: " .. ego)
                protocol = " subtype=mace skill=" .. skill .. " ego=" .. ego
                break
            end
        end
        for _, it in ipairs(items.get_items_at(0, 0) or {}) do
            if it.subtype_en() == "boots" then
                boots_name = it.name()
                assert(ch_stash_search_annotate_item(it):find("{boots armor}",
                                                       1, true),
                       "stash annotation failed for boots without a normal ego")
                break
            end
        end
        assert(protocol, "starter weapon protocol fields were not available")
        assert(boots_name, "created boots were not visible at the player's feet")
        emit("item:running_boots", boots_name .. protocol)
        crawl.sendkeys(".")
    elseif action == 9 then
        crawl.clear_messages(false)
        crawl.sendkeys("&_特洛格" .. eol)
    elseif action == 10 then
        crawl.sendkeys(".")
    elseif action == 11 then
        local msgs = crawl.messages(20) or ""
        emit("god:Trog", msgs)
        crawl.sendkeys(".")
    elseif action == 12 then emit("phase:ui:done", "done")
        crawl.sendkeys(string.char(19))
    end
end
}
