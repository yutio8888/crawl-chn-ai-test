name = zh_ui_check
species = mu
background = ck
weapon = mace
restart_after_game = false
show_more = false

Lua{
local eol  = string.char(13)
local esc  = string.char(27)
local action = 0

local function emit(case_id, text)
    if text == nil then text = "<nil>" end
    local one_line = tostring(text):gsub("\r\n", "\\n"):gsub("\n", "\\n")
    crawl.stderr("FRAME_MARKER: " .. case_id .. " | " .. one_line .. eol)
end

function ready()
    action = action + 1

    if action == 1 then
        crawl.enable_more(false)
        crawl.set_sendkeys_errors(true)
        crawl.sendkeys(".")
    elseif action == 2 then
        emit("probe:ui", "t_=" .. crawl.t_("You attack %s.") .. " lang=" .. crawl.language())
        crawl.sendkeys(".")
    elseif action == 3 then
        crawl.clear_messages(false)
        crawl.sendkeys("&o)demon whip" .. eol .. "chaos" .. eol)
    elseif action == 4 then
        crawl.sendkeys(".")
    elseif action == 5 then
        -- Capture messages from item creation (dedicated ready() for safety)
        local msgs = crawl.messages(20) or ""
        emit("item:chaos_demon_whip", msgs)
        crawl.sendkeys(".")
    elseif action == 6 then
        crawl.clear_messages(false)
        crawl.sendkeys("g&o[boots" .. eol .. "running" .. eol)
    elseif action == 7 then
        crawl.sendkeys(".")
    elseif action == 8 then
        local msgs = crawl.messages(20) or ""
        emit("item:running_boots", msgs)
        crawl.sendkeys(".")
    elseif action == 9 then
        crawl.clear_messages(false)
        crawl.sendkeys("&_特洛格" .. eol)
    elseif action == 10 then
        crawl.sendkeys(".")
    elseif action == 11 then
        local msgs = crawl.messages(20) or ""
        emit("god:Trog", msgs)
        crawl.sendkeys(".")
    elseif action == 12 then emit("phase:ui:done", "done")
        crawl.sendkeys(string.char(19))
    end
end
}
