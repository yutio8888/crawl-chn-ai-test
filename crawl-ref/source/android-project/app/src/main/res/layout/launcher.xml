<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/launcherRoot"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true"
    tools:context=".DCSSLauncher">

    <ScrollView
        android:id="@+id/launcherScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:fitsSystemWindows="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/logoView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/app_name"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/logo" />

            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/start_game"
                android:theme="@style/ButtonColor2"/>

            <Button
                android:id="@+id/morgueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/morgue"/>

            <Button
                android:id="@+id/inputDisplayButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/input_display"/>

            <LinearLayout
                android:id="@+id/inputDisplayGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/virtual_keyboard"
                    android:labelFor="@+id/keyboardSpinner"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@id/keyboardSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@drawable/green_spinner"
                    android:contentDescription="@string/virtual_keyboard"
                    android:popupBackground="@color/dark_green"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/extra_keyboard"
                    android:labelFor="@+id/extraKeyboardSpinner"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@id/extraKeyboardSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@drawable/green_spinner"
                    android:contentDescription="@string/extra_keyboard"
                    android:popupBackground="@color/dark_green"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/keyboard_height_dp"
                    android:labelFor="@+id/keyboardSize"
                    android:textStyle="bold" />

                <EditText
                    android:id="@id/keyboardSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:nextFocusDown="@+id/readingSize" />

                <TextView
                    android:id="@+id/keyboardSizeRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/keyboard_size_presets"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <Button
                        android:id="@+id/keyboardSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:minHeight="48dp"
                        android:textAllCaps="false"
                        android:text="@string/size_small" />

                    <Button
                        android:id="@+id/keyboardStandard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:minHeight="48dp"
                        android:textAllCaps="false"
                        android:text="@string/size_standard" />

                    <Button
                        android:id="@+id/keyboardLarge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:minHeight="48dp"
                        android:textAllCaps="false"
                        android:text="@string/size_large" />
                </LinearLayout>

                <TextView
                    android:id="@+id/keyboardSizeApplied"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/keyboard_preview"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/keyboardPreviewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/keyboardPreviewSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/reading_size"
                    android:labelFor="@id/readingSize"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@id/readingSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@drawable/green_spinner"
                    android:contentDescription="@string/reading_size"
                    android:popupBackground="@color/dark_green"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:id="@+id/readingSizePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="6dp"
                    android:text="@string/reading_size_preview" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reading_size_help" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/map_scale_help" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/fullScreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/full_screen"
                    android:checked="true" />
            </LinearLayout>

            <Button
                android:id="@+id/advancedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/advanced"/>

            <LinearLayout
                android:id="@+id/advancedGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/editInitFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/edit_rc"/>

                <Button
                    android:id="@+id/modsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/mods"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
