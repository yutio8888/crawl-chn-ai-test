{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dcss-zh-review-findings-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "bundle_sha256", "routing_sha256", "reviewer", "findings"],
  "properties": {
    "schema": {"const": "dcss-zh-review-findings-v1"},
    "bundle_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "routing_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "file", "line", "evidence", "impact", "fix"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"},
          "severity": {"enum": ["blocker", "needs_fix", "suggestion"]},
          "file": {"type": "string", "minLength": 1, "maxLength": 512},
          "line": {"type": "integer", "minimum": 1, "maximum": 10000000},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 4000},
          "impact": {"type": "string", "minLength": 1, "maxLength": 4000},
          "fix": {"type": "string", "minLength": 1, "maxLength": 4000},
          "english": {"type": "string", "minLength": 1, "maxLength": 4000},
          "chinese": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"reviewer": {"const": "translation-reviewer"}}},
      "then": {
        "properties": {
          "findings": {
            "items": {"required": ["id", "severity", "file", "line", "evidence", "impact", "fix", "english", "chinese"]}
          }
        }
      },
      "else": {
        "properties": {
          "findings": {
            "items": {
              "not": {"anyOf": [{"required": ["english"]}, {"required": ["chinese"]}]}
            }
          }
        }
      }
    }
  ]
}
