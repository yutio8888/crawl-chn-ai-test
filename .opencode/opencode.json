{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugin": ["opencode-goal-plugin"],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  },
  "agent": {
    "explore": {
      "model": "deepseek/deepseek-v4-flash"
    }
  }
}
